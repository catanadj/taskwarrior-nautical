#!/usr/bin/env python3
"""Nautical command-line entry point."""

from __future__ import annotations

import os
import runpy
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent
NAUTICAL_VERSION = "7.6.1"
COMMANDS = {
    "install": ROOT / "nautical_core" / "tools" / "nautical_install.py",
    "runtime-clean": ROOT / "nautical_core" / "tools" / "nautical_runtime_cleanup.py",
    "doctor": ROOT / "nautical_core" / "tools" / "nautical_doctor.py",
    "queue-status": ROOT / "nautical_core" / "tools" / "nautical_queue_status.py",
    "queue-review": ROOT / "nautical_core" / "tools" / "nautical_queue_review.py",
    "review": ROOT / "nautical_core" / "tools" / "nautical_queue_review.py",
    "backup": ROOT / "nautical_core" / "tools" / "nautical_backup.py",
    "restore": ROOT / "nautical_core" / "tools" / "nautical_restore.py",
    "reconcile": ROOT / "nautical_core" / "tools" / "nautical_reconcile.py",
    "query": ROOT / "nautical_core" / "tools" / "nautical_query.py",
    "navigator": ROOT / "nautical_navigator.py",
}
ALIASES = {
    "queue": "queue-status",
    "nav": "navigator",
}
COMMAND_DESCRIPTIONS = (
    ("install", "Install hooks, runtime files, and configuration."),
    ("runtime-clean", "Remove obsolete managed runtime files safely."),
    ("doctor", "Inspect installation, configuration, and runtime health."),
    ("queue-status", "Show pending lifecycle and manual-review queue status."),
    ("queue-review", "Interactively review queued manual-review items."),
    ("review", "Alias for queue-review with the same interactive review flow."),
    ("backup", "Create a verified backup of Nautical data."),
    ("restore", "Restore Nautical data from a verified backup."),
    ("reconcile", "Plan or apply chain and lifecycle reconciliation."),
    ("query", "Query tasks through the public Nautical query API."),
    ("navigator", "Open the interactive task navigator."),
)


def _checkout_root() -> Path | None:
    """Find a Nautical checkout for first-install recovery."""
    candidates = []
    configured = (os.environ.get("NAUTICAL_SOURCE") or "").strip()
    if configured:
        candidates.append(Path(configured).expanduser())
    candidates.append(Path.cwd())
    for candidate in candidates:
        try:
            resolved = candidate.resolve()
        except OSError:
            continue
        if resolved.is_file():
            resolved = resolved.parent
        for root in (resolved, *resolved.parents):
            if all(
                (root / name).is_file()
                for name in (
                    "nautical",
                    "on-add.nautical",
                    "on-modify.nautical",
                    "on-exit.nautical",
                    "nautical_core/tools/nautical_install.py",
                )
            ):
                return root
    return None


def _has_source_argument(arguments: list[str]) -> bool:
    return any(value == "--source" or value.startswith("--source=") for value in arguments)


def _print_help() -> None:
    print(f"Nautical {NAUTICAL_VERSION}")
    print("usage: nautical [--help | --version] <command> [options]")
    print("commands:")
    for command, description in COMMAND_DESCRIPTIONS:
        print(f"  {command:<15} {description}")
    print("aliases:")
    print("  queue           alias for queue-status")
    print("  nav             alias for navigator")
    print("global options:")
    print("  -h, --help       show this help message")
    print("  --version        show the Nautical version")


def main() -> int:
    if len(sys.argv) < 2 or sys.argv[1] in {"-h", "--help"}:
        _print_help()
        return 0
    if sys.argv[1] == "--version":
        print(f"Nautical {NAUTICAL_VERSION}")
        return 0
    command = ALIASES.get(sys.argv[1], sys.argv[1])
    target = COMMANDS.get(command)
    if target is None:
        print(f"nautical: unknown command '{sys.argv[1]}'", file=sys.stderr)
        return 2
    if not target.is_file():
        if command == "install":
            checkout = _checkout_root()
            if checkout is not None:
                target = checkout / "nautical_core" / "tools" / "nautical_install.py"
        if not target.is_file():
            print(
                "nautical: installed runtime is missing; run './nautical install' "
                "from a Nautical checkout (or set NAUTICAL_SOURCE)",
                file=sys.stderr,
            )
            return 2
    arguments = list(sys.argv[2:])
    if command == "install" and not _has_source_argument(arguments):
        checkout = _checkout_root()
        if checkout is not None:
            arguments = ["--source", str(checkout), *arguments]
    sys.argv = [str(target), *arguments]
    runpy.run_path(str(target), run_name="__main__")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
